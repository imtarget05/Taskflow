generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MEMBER
  VIEWER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ColumnType {
  STANDARD // Kanban regular
  SC_WORKFLOW // Supply Chain workflow: PO Received → Approved → Fulfillment → Shipped
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  password             String?
  googleId             String?   @unique
  name                 String
  avatarUrl            String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  refreshTokens        RefreshToken[]
  projects             Project[]            @relation("OwnerProjects")
  memberships          ProjectMember[]
  assignments          TaskAssignment[]
  tasksCreated         Task[]               @relation("CreatedTasks")
  comments             Comment[]
  activities           Activity[]
  integrations         Integration[]
  agentConversations   AgentConversation[]
  agentPlans           AgentPlan[]
  chatGroupMemberships ChatGroupMember[]
  chatMessages         ChatMessage[]
  ticketAnalyses       TicketAnalysis[]
  nlpFeedbacks         NlpFeedback[]
  scOrderAnalyses      SCOrderAnalysis[]
  agenticDecisions     AgenticDecision[]
  securityAudits       SecurityAudit[]
  skills               UserSkill[]
  availabilities       UserAvailability[]
  recommendations      TaskRecommendation[]
  memoryNodes          MemoryNode[]

  @@map("users")
}

model ChatGroup {
  id        String   @id @default(cuid())
  projectId String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members  ChatGroupMember[]
  messages ChatMessage[]

  @@map("chat_groups")
}

model ChatGroupMember {
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("chat_group_members")
}

model ChatMessage {
  id        String   @id @default(cuid())
  groupId   String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  group  ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("chat_messages")
}

model Integration {
  id        String   @id @default(cuid())
  userId    String
  kind      String // e.g. "N8N"
  name      String
  config    Json? // encrypted credential payload (app-level)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("integrations")
}

model AgentConversation {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  title     String?
  messages  Json?
  summary   String? // Rolling summary of messages trimmed out of the LLM context window
  language  String? // Resolved language for this conversation ('vi', 'en', 'zh', or null)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, projectId])
  @@map("agent_conversations")
}

model AgentPlan {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  title     String?
  payload   Json
  status    String   @default("PENDING") // PENDING | PREVIEWED | APPLYING | APPLIED | FAILED | CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, projectId])
  @@map("agent_plans")
}

// Token usage ledger for the AI assistant (neuron-budget observability).
model AIUsage {
  id           String   @id @default(cuid())
  model        String
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("ai_usage")
}

// NLP ticket classification results. One row per analysed piece of text
// (task title/description, comment, or standalone ticket). Category, priority
// and sentiment are produced by the LLM; duplicateOf is the id of a previous
// analysis judged semantically equivalent (embedding cosine similarity).
model TicketAnalysis {
  id                 String        @id @default(cuid())
  userId             String
  projectId          String?
  taskId             String?
  sourceText         String        @db.Text
  category           String
  categoryConfidence Float
  priority           String // LOW | MEDIUM | HIGH | URGENT
  priorityConfidence Float
  sentiment          String // positive | neutral | negative
  urgency            Boolean
  language           String // vi | en | zh
  keywords           Json?
  duplicateOf        String?
  duplicateScore     Float?
  createdAt          DateTime      @default(now())
  feedbacks          NlpFeedback[]

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("ticket_analyses")
}

model NlpFeedback {
  id         String   @id @default(cuid())
  userId     String
  analysisId String
  category   String
  priority   String // LOW | MEDIUM | HIGH | URGENT
  decision   String // applied | ignored
  createdAt  DateTime @default(now())

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisRef TicketAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([category])
  @@map("nlp_feedbacks")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner            User                 @relation("OwnerProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  members          ProjectMember[]
  columns          Column[]
  tasks            Task[]
  activities       Activity[]
  chatGroup        ChatGroup?
  ticketAnalyses   TicketAnalysis[]
  orders           Order[]
  inventoryItems   InventoryItem[]
  scOrderAnalyses  SCOrderAnalysis[]
  agenticDecisions AgenticDecision[]
  recommendations  TaskRecommendation[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Column {
  id         String     @id @default(cuid())
  projectId  String
  name       String
  position   Int
  columnType ColumnType @default(STANDARD)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, position])
  @@map("columns")
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  columnId    String
  title       String
  description String?
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIUM)
  position    Int
  completed   Boolean      @default(false)
  createdById String
  metadata    Json? // Custom fields: orderId, PO reference, v.v.
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column          Column               @relation(fields: [columnId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation("CreatedTasks", fields: [createdById], references: [id])
  assignments     TaskAssignment[]
  comments        Comment[]
  activities      Activity[]
  analyses        TicketAnalysis[]
  recommendations TaskRecommendation[]

  @@index([columnId, position])
  @@index([projectId])
  @@map("tasks")
}

model TaskAssignment {
  id     String @id @default(cuid())
  taskId String
  userId String
  role   Role   @default(MEMBER)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_assignments")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("comments")
}

model Activity {
  id        String   @id @default(cuid())
  projectId String
  taskId    String?
  userId    String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// Supply Chain domain (Phase 2 — P2P / Order-to-Cash automation)
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_APPROVAL
  APPROVED
  IN_FULFILLMENT
  SHIPPED
  DELIVERED
  CANCELLED
  CLOSED
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique // e.g. "SUP-001"
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@map("suppliers")
}

model Order {
  id           String      @id @default(cuid())
  projectId    String
  supplierId   String
  orderNumber  String      @unique // PO number / internal reference
  status       OrderStatus @default(PENDING_APPROVAL)
  requestDate  DateTime?
  deliveryDate DateTime?
  totalAmount  Float?
  currency     String      @default("VND")
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  lineItems        LineItem[]
  scAnalyses       SCOrderAnalysis[]
  agenticDecisions AgenticDecision[]

  @@index([projectId, status])
  @@index([supplierId])
  @@map("orders")
}

model LineItem {
  id          String   @id @default(cuid())
  orderId     String
  sku         String
  description String?
  quantity    Int
  unitPrice   Float
  amount      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("line_items")
}

model InventoryItem {
  id        String   @id @default(cuid())
  projectId String
  sku       String
  name      String
  quantity  Int      @default(0)
  unit      String   @default("Cái")
  location  String? // e.g. "Kho A - Kệ 3"
  minStock  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sku])
  @@index([projectId])
  @@map("inventory_items")
}

// ---------------------------------------------------------------------------
// SC NLP Analysis — phân loại order type (PO mới / PO cập nhật / Invoice / ASN)
// từ văn bản tiếng Việt. Dữ liệu này riêng cho SC domain, không trộn với
// TicketAnalysis (support ticket classification).
// ---------------------------------------------------------------------------

enum ScOrderType {
  PO_NEW // Purchase Order mới
  PO_UPDATE // PO cập nhật / điều chỉnh (annotation, quantity change)
  INVOICE // Hóa đơn
  ASN // Advanced Shipping Notice
  UNKNOWN // Không xác định / fallback
}

model SCOrderAnalysis {
  id              String      @id @default(cuid())
  userId          String
  projectId       String?
  orderId         String? // reference đến Order nếu có
  sourceText      String      @db.Text
  classification  ScOrderType @default(UNKNOWN)
  confidence      Float // 0.0-1.0, độ tin cậy phân loại
  suggestedAction String? // gợi ý action: "phê duyệt PO", "gửi cho bộ phận kế toán", v.v.
  workflowTrigger String? // SC workflow trigger: "approve_po", "invoice_verify", v.v.
  priority        String? // LOW | MEDIUM | HIGH | URGENT (nếu gợi ý)
  llmModel        String? // model dùng để phân loại (để audit)
  llmUsed         Boolean     @default(false) // có dùng LLM hay chỉ rule-based
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId])
  @@map("sc_order_analyses")
}

model AgenticDecision {
  id             String   @id @default(cuid())
  orderId        String
  projectId      String
  userId         String // người tạo decision (agent hoặc human trigger)
  classification String // PO_NEW, PO_UPDATE, INVOICE, ASN, UNKNOWN
  confidence     Float // 0.0-1.0
  decision       String // auto | human_task | manual_review
  action         String // JSON string của AgenticAction
  taskId         String? // nếu tạo task tự động
  humanTaskId    String? // nếu tạo human task
  processedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([projectId, decision])
  @@map("agentic_decisions")
}

// ---------------------------------------------------------------------------
// Security audit trail
// Independent of the Activity feed (which is project-scoped). Captures auth &
// authorization events (login success/failure, forbidden access, token issues)
// so they are durable and queryable even when no project context exists yet.
// ---------------------------------------------------------------------------

model SecurityAudit {
  id        String   @id @default(cuid())
  action    String // e.g. AUTH_LOGIN_SUCCESS, AUTH_LOGIN_FAILED, AUTH_FORBIDDEN
  userId    String? // set when the actor is known (authenticated or identified)
  email     String? // set for login attempts (success or fail) for traceability
  ip        String? // best-effort client IP (trust proxy = 1 in app.ts)
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([userId])
  @@index([email])
  @@map("security_audits")
}

// ---------------------------------------------------------------------------
// Task Recommendation Engine — đề xuất task nội bộ dựa trên kỹ năng,
// availability, workload, lịch sử hoàn thành, và priority.
// ---------------------------------------------------------------------------

model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  skill     String // e.g. "react", "nodejs", "design"
  level     Int      @default(1) // 1-5
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
  @@index([userId])
  @@map("user_skills")
}

model UserAvailability {
  id        String  @id @default(cuid())
  userId    String
  dayOfWeek Int // 0-6 (Sunday-Saturday)
  morning   Boolean @default(true)
  afternoon Boolean @default(true)
  evening   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
  @@index([userId])
  @@map("user_availability")
}

model TaskRecommendation {
  id        String    @id @default(cuid())
  userId    String
  projectId String
  taskId    String
  score     Float // 0.0-1.0
  reason    String // Lý do đề xuất (Vietnamese)
  factors   Json // { skillMatch, availability, workload, history, priority }
  status    String    @default("pending") // pending | accepted | dismissed | expired
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, score])
  @@index([projectId])
  @@map("task_recommendations")
}

model RecommendationConfig {
  id    String @id @default(cuid())
  key   String @unique // "weights", "thresholds"
  value Json

  @@map("recommendation_configs")
}

// ---------------------------------------------------------------------------
// GraphRAG / Cross-Session Memory
// Knowledge graph connecting entities across sessions. MemoryNode stores
// facts/preferences/decisions with pgvector embeddings for semantic search;
// MemoryRelation links nodes with typed edges (related_to, causes, precedes,
// contradicts) to form a traversable memory graph.
// ---------------------------------------------------------------------------

model MemoryNode {
  id         String                      @id @default(cuid())
  userId     String
  user       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String // The fact/memory content
  category   String // 'preference', 'fact', 'decision', 'context'
  source     String // 'conversation', 'task', 'manual'
  confidence Float                       @default(1.0)
  embedding  Unsupported("vector(768)")?
  metadata   Json?
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  outgoingRelations MemoryRelation[] @relation("source")
  incomingRelations MemoryRelation[] @relation("target")

  @@index([userId])
  @@index([category])
  @@map("memory_nodes")
}

model MemoryRelation {
  id           String     @id @default(cuid())
  sourceId     String
  source       MemoryNode @relation("source", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId     String
  target       MemoryNode @relation("target", fields: [targetId], references: [id], onDelete: Cascade)
  relationType String // 'related_to', 'causes', 'precedes', 'contradicts'
  strength     Float      @default(1.0)

  @@unique([sourceId, targetId, relationType])
  @@map("memory_relations")
}

// ---------------------------------------------------------------------------
// Prompt Engineering System
// Quản lý prompt templates, versioning, A/B testing và performance tracking.
// ---------------------------------------------------------------------------

model PromptTemplate {
  id        String   @id @default(cuid())
  name      String // 'legal_rag', 'agent_system', 'nlp_classifier'
  version   String // semantic version: '1.0.0', '1.1.0'
  content   String   @db.Text // The prompt template text
  variables String[] // Variable names: ['question', 'context']
  isActive  Boolean  @default(false) // Only one active per name
  metrics   Json? // { accuracy, latency, usageCount }
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiments PromptExperiment[]

  @@unique([name, version])
  @@index([name, isActive])
  @@map("prompt_templates")
}

model PromptExperiment {
  id           String    @id @default(cuid())
  name         String // 'chunk_size_test', 'top_k_comparison'
  promptName   String    @unique // Which prompt template this tests (1:1 with active version)
  variantA     String // Version A
  variantB     String // Version B
  status       String    @default("running")
  trafficSplit Float     @default(0.5) // 50/50 split
  resultsA     Json? // { accuracy, count, avgLatency }
  resultsB     Json? // { accuracy, count, avgLatency }
  winner       String? // 'A', 'B', or null
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  promptTemplate PromptTemplate @relation(fields: [promptName], references: [id], onDelete: Cascade)

  @@index([promptName, status])
  @@map("prompt_experiments")
}

// ---------------------------------------------------------------------------
// LLM Evaluation Framework (Ragas-like metrics)
// Stores evaluation run results for comparing prompt/model/config changes.
// ---------------------------------------------------------------------------

model EvaluationRun {
  id            String   @id @default(cuid())
  name          String // 'legal_rag_v1', 'chunk_size_experiment'
  promptVersion String?
  datasetSize   Int
  metrics       Json // { faithfulness, answerRelevancy, contextRecall, contextPrecision, accuracy }
  config        Json? // { chunkSize, topK, rerankDepth, model }
  createdAt     DateTime @default(now())

  @@index([name])
  @@map("evaluation_runs")
}

// ---------------------------------------------------------------------------
// MLOps Experiment Tracking
// Tracks retrieval tuning experiments (chunk size, top-K, rerank depth).
// ---------------------------------------------------------------------------

model RetrievalExperiment {
  id          String    @id @default(cuid())
  name        String
  description String?
  config      Json
  datasetSize Int       @default(0)
  metrics     Json?
  status      String    @default("running")
  createdBy   String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([name])
  @@index([status])
  @@map("retrieval_experiments")
}
