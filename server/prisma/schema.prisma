generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MEMBER
  VIEWER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String?
  googleId  String?   @unique
  name      String
  avatarUrl String?
  passwordResetToken  String?
  passwordResetExpires DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  refreshTokens  RefreshToken[]
  projects       Project[]        @relation("OwnerProjects")
  memberships    ProjectMember[]
  assignments    TaskAssignment[]
  tasksCreated   Task[]           @relation("CreatedTasks")
  comments       Comment[]
  activities     Activity[]
  integrations   Integration[]
  agentConversations AgentConversation[]
  agentPlans     AgentPlan[]
  chatGroupMemberships ChatGroupMember[]
  chatMessages   ChatMessage[]
  ticketAnalyses TicketAnalysis[]

  @@map("users")
}

model ChatGroup {
  id        String   @id @default(cuid())
  projectId String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members  ChatGroupMember[]
  messages ChatMessage[]

  @@map("chat_groups")
}

model ChatGroupMember {
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("chat_group_members")
}

model ChatMessage {
  id        String   @id @default(cuid())
  groupId   String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  group  ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("chat_messages")
}

model Integration {
  id        String   @id @default(cuid())
  userId    String
  kind      String   // e.g. "N8N"
  name      String
  config    Json?    // encrypted credential payload (app-level)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("integrations")
}

model AgentConversation {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  title     String?
  messages  Json?
  language  String?  // Resolved language for this conversation ('vi', 'en', 'zh', or null)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, projectId])
  @@map("agent_conversations")
}

model AgentPlan {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  title     String?
  payload   Json
  status    String   @default("PENDING") // PENDING | PREVIEWED | APPLYING | APPLIED | FAILED | CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, projectId])
  @@map("agent_plans")
}

// Legal research (tra cứu pháp luật): Vietnamese legislation corpus.
model LegalDocument {
  id             String   @id @default(cuid())
  sourceUrl      String   @unique
  title          String
  documentNumber String?
  issueDate      DateTime?
  effectiveDate  DateTime?
  statusEffect   String? // "Còn hiệu lực" | "Hết hiệu lực" | "Hết hiệu lực một phần" | ...
  rawText        String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  chunks LegalChunk[]

  @@index([title])
  @@map("legal_documents")
}

// Chunked by article (điều/khoản) for retrieval; embedding is a pgvector
// column managed through raw SQL (Prisma Unsupported type).
model LegalChunk {
  id         String  @id @default(cuid())
  documentId String
  articleRef String // e.g. "Điều 5", "Khoản 2 Điều 10"
  content    String  @db.Text
  embedding  Unsupported("vector(1024)")?
  metadata   Json?
  createdAt  DateTime @default(now())

  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("legal_chunks")
}

// Deterministic cache for repeated questions — protects the daily neuron budget.
model LegalCache {
  id           String   @id @default(cuid())
  questionHash String   @unique @db.VarChar(64)
  question     String   @db.Text
  answer       String   @db.Text
  citations    Json?
  modelUsed    String?
  createdAt    DateTime @default(now())

  @@map("legal_cache")
}

// Token usage ledger for the AI assistant (neuron-budget observability).
model AIUsage {
  id           String   @id @default(cuid())
  model        String
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("ai_usage")
}

// NLP ticket classification results. One row per analysed piece of text
// (task title/description, comment, or standalone ticket). Category, priority
// and sentiment are produced by the LLM; duplicateOf is the id of a previous
// analysis judged semantically equivalent (embedding cosine similarity).
model TicketAnalysis {
  id                 String   @id @default(cuid())
  userId             String
  projectId          String?
  taskId             String?
  sourceText         String   @db.Text
  category           String
  categoryConfidence Float
  priority           String // LOW | MEDIUM | HIGH | URGENT
  priorityConfidence Float
  sentiment          String // positive | neutral | negative
  urgency            Boolean
  language           String // vi | en | zh
  keywords           Json?
  duplicateOf        String?
  duplicateScore     Float?
  createdAt          DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("ticket_analyses")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner      User           @relation("OwnerProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  members    ProjectMember[]
  columns    Column[]
  tasks      Task[]
  activities Activity[]
  chatGroup  ChatGroup?
  ticketAnalyses TicketAnalysis[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Column {
  id        String   @id @default(cuid())
  projectId String
  name      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, position])
  @@map("columns")
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  columnId    String
  title       String
  description String?
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIUM)
  position    Int
  completed   Boolean      @default(false)
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column       Column          @relation(fields: [columnId], references: [id], onDelete: Cascade)
  createdBy    User            @relation("CreatedTasks", fields: [createdById], references: [id])
  assignments  TaskAssignment[]
  comments     Comment[]
  activities   Activity[]
  analyses     TicketAnalysis[]

  @@index([columnId, position])
  @@index([projectId])
  @@map("tasks")
}

model TaskAssignment {
  id     String @id @default(cuid())
  taskId String
  userId String
  role   Role   @default(MEMBER)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_assignments")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("comments")
}

model Activity {
  id        String   @id @default(cuid())
  projectId String
  taskId    String?
  userId    String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])
  task    Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("activities")
}
