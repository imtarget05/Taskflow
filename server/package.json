{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "TaskFlow REST API + WebSocket server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --testPathIgnorePatterns=\"integration\"",
    "eval:agent": "jest --config jest.config.js --runInBand tests/eval/agent-eval.test.ts",
    "mcp": "tsx scripts/mcp-server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "legal:index": "tsx scripts/index-legal.ts",
    "db:up": "docker-compose up -d db",
    "eval:report": "jest --config jest.config.js --runInBand tests/eval/accuracy-report.test.ts",
    "eval:benchmark": "npx ts-node tests/eval/benchmark-report.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "googleapis": "^176.0.0",
    "helmet": "^8.0.0",
    "http-status-codes": "^2.3.0",
    "js-tiktoken": "^1.0.21",
    "jsonwebtoken": "^9.0.2",
    "langfuse": "^3.38.20",
    "multer": "^2.2.0",
    "nodemailer": "^9.1.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.1",
    "unpdf": "^1.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
