# Server configuration
NODE_ENV=development
PORT=4000

# CORS
CLIENT_URL=http://localhost:5173
# Multiple frontend origins (comma-separated) for express + socket.io CORS
# ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

# Database
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public

# JWT
JWT_SECRET=change_me_super_secret_access
JWT_REFRESH_SECRET=change_me_super_secret_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_LOGIN=10
RATE_LIMIT_AUTH_REGISTER=20
RATE_LIMIT_AUTH_REFRESH=30

# Google OAuth (optional until configured in Google Cloud Console)
# FRONTEND_URL is where the browser lands after the OAuth callback.
# GOOGLE_REDIRECT_ORIGIN defaults to the API host (prod) or localhost:4000.
FRONTEND_URL=http://localhost:5173
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_ORIGIN=http://localhost:4000
RATE_LIMIT_MAX=100
# Per-endpoint auth limits
RATE_LIMIT_AUTH_LOGIN=10
RATE_LIMIT_AUTH_REGISTER=20
RATE_LIMIT_AUTH_REFRESH=30
