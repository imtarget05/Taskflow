# Server configuration
NODE_ENV=development
PORT=4000

# CORS
CLIENT_URL=http://localhost:5173
# Multiple frontend origins (comma-separated) for express + socket.io CORS
# ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

# Database
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public

# JWT
JWT_SECRET=change_me_super_secret_access
JWT_REFRESH_SECRET=change_me_super_secret_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_LOGIN=10
RATE_LIMIT_AUTH_REGISTER=20
RATE_LIMIT_AUTH_REFRESH=30

# Google OAuth (optional until configured in Google Cloud Console)
# FRONTEND_URL is where the browser lands after the OAuth callback.
# GOOGLE_REDIRECT_ORIGIN defaults to the API host (prod) or localhost:4000.
FRONTEND_URL=http://localhost:5173
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_ORIGIN=http://localhost:4000
RATE_LIMIT_MAX=100
# Per-endpoint auth limits
RATE_LIMIT_AUTH_LOGIN=10
RATE_LIMIT_AUTH_REGISTER=20
RATE_LIMIT_AUTH_REFRESH=30

# Email (optional: enables password-reset emails; otherwise the reset link
# is returned in the forgot-password response for testing).
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# AI assistant — OpenAI-compatible endpoint (OpenAI, Cloudflare Workers AI,
# Ollama, vLLM, ...). Server-side only; the browser never sees credentials.
# Cloudflare Workers AI example:
#   LLM_PROVIDER=cloudflare
#   LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
#   LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
#   LLM_API_KEY=<Cloudflare API token with Workers AI read + run permissions>
# LLM router: the default tier is used for most requests; complex questions
# escalate to premium / reasoning tiers automatically (llm.ts routeModel).
#   LLM_MODEL_PREMIUM=@cf/meta/llama-3.3-70b-instruct-fp8-fast
#   LLM_MODEL_REASONING=@cf/deepseek-ai/deepseek-r1-distill-qwen-32b
#   LLM_EMBED_MODEL=@cf/baai/bge-m3
#   LLM_RERANK_MODEL=@cf/baai/bge-reranker-base
# Local Ollama example:
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b
LLM_PROVIDER=ollama
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
# LLM_TIMEOUT_MS=120000

# Legal research (tra cứu pháp luật) — RAG over Vietnamese legislation.
# Requires LLM_BASE_URL + LLM_EMBED_MODEL + LLM_RERANK_MODEL + pgvector on the DB.
LEGAL_ENABLED=false
RATE_LIMIT_LEGAL=10

# n8n integration (user-hosted instance, reached server-side only).
# N8N_API_URL=
# N8N_API_KEY=
# N8N_SIGNING_SECRET=
# INTEGRATIONS_ENCRYPTION_KEY=

# Google Sheets export (optional). Create a service account in Google Cloud,
# enable the Sheets + Drive APIs, and paste the JSON key fields.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=taskflow-export@<project>.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# GOOGLE_SHEETS_DELEGATED_USER=you@yourdomain.com
